rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Products collection
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      
      // Only authenticated users can write, update, delete
      allow write, update, delete: if isAuthenticated();
      
      // Validate data on create
      allow create: if isAuthenticated() 
        && request.resource.data.keys().hasAll(['title', 'price', 'description', 'category', 'imageUrl', 'affiliateLink'])
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.imageUrl is string
        && request.resource.data.affiliateLink is string;
      
      // Validate data on update
      allow update: if isAuthenticated()
        && (request.resource.data.title is string || !request.resource.data.keys().hasAny(['title']))
        && (request.resource.data.price is number || !request.resource.data.keys().hasAny(['price']))
        && (request.resource.data.description is string || !request.resource.data.keys().hasAny(['description']))
        && (request.resource.data.category is string || !request.resource.data.keys().hasAny(['category']))
        && (request.resource.data.imageUrl is string || !request.resource.data.keys().hasAny(['imageUrl']))
        && (request.resource.data.affiliateLink is string || !request.resource.data.keys().hasAny(['affiliateLink']));
    }
  }
}
